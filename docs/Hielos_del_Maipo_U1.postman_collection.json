        "url": "{{base_url}}/api/solicitudes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente_referencia\": \"Cliente ficticio\",\n  \"cantidad\": -2,\n  \"fecha_requerida\": \"2026-11-15\",\n  \"estado\": \"despachado\"\n}",
          "options": {
            "raw": {
              "language": "json"
